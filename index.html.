<script>
const $=s=>document.querySelector(s),n=s=>String(s).toLowerCase().replace(/ё/g,'е').replace(/[^а-яa-z0-9 ]/g,'').replace(/\s+/g,' ').trim(),esc=s=>String(s).replace(/[<>&"]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
const TP={orf:"Орфография",pun:"Пунктуация",mor:"Морфология",sin:"Синтаксис",fon:"Фонетика",lek:"Лексика",fra:"Фразеология",slo:"Словообразование",mfm:"Морфемика",sti:"Стилистика",kul:"Культура речи"},LV=["BASIC","ADVANCED","OLYMPIAD"];
const TH={orf:"Проверяй безударные гласные подбором однокоренного слова. В суффиксах -ан-, -ян-, -ин- пишется одна Н (исключения: стеклянный, оловянный, деревянный), а в -онн-, -енн- — две Н (кроме ветреный). ПРЕ- = «очень» или «пере-», ПРИ- = приближение, присоединение, неполнота действия. НЕ с глаголами и деепричастиями пишется раздельно, кроме слов без НЕ (ненавидеть, негодуя). <i>Пример: прекрасный, приклеить.</i>",
pun:"Запятая отделяет однородные члены (без одиночного И), части сложного предложения, обращения и обособленные обороты. Деепричастный оборот выделяется запятыми (кроме фразеологизмов: бежать сломя голову). Причастный оборот обособляется после определяемого слова. Тире — между подлежащим и сказуемым-существительными. <i>Пример: Войдя в класс, он поздоровался.</i>",
mor:"В 7 классе: причастие (какой? — читающий), деепричастие (что делая? — читая), наречие, категория состояния (На улице жарко), предлоги, союзы, частицы. НЕ с наречиями на -о/-е слитно, если есть синоним без НЕ; раздельно при противопоставлении с союзом «а» или словах «далеко не», «вовсе не», «отнюдь не».",
sin:"Основа предложения — подлежащее и сказуемое. Чтобы определить тип предложения, найди все грамматические основы. Сложные предложения: сочинённые (ССП), подчинённые (СПП), бессоюзные (БСП). Безличные предложения не имеют подлежащего и не допускают его подстановки в именительном падеже.",
fon:"Звук — это не буква. Звонкие согласные оглушаются на конце слова и перед глухими, глухие озвончаются перед звонкими (кроме сонорных и В). Буквы е, ё, ю, я дают два звука в начале слова и после гласных, ь, ъ. <i>Пример: ёлка — [й’олка], 5 звуков при 4 буквах.</i>",
lek:"Лексика изучает значения слов: синонимы, антонимы, омонимы (и омоформы, омофоны, омографы), паронимы, архаизмы, историзмы, неологизмы, заимствования, многозначность.",
fra:"Фразеологизм — устойчивое сочетание слов с переносным цельным значением; в предложении он является одним членом. Нельзя произвольно менять слова в его составе (не смешивай «играть роль» и «иметь значение»). <i>Пример: бить баклуши = бездельничать.</i>",
slo:"Способы: приставочный, суффиксальный, приставочно-суффиксальный, бессуффиксный (усечение), сложение, переход из одной части речи в другую (субстантивация: мороженое, столовая). <i>Пример: подснежник — приставочно-суффиксальный.</i>",
mfm:"Морфемы: приставка, корень, суффикс, окончание. Различай словообразовательные (суффиксы, приставки) и формообразующие морфемы (окончания, суффикс прошедшего времени -л-, суффиксы инфинитива -ть/-ти). Не путай омонимичные корни (водить / вода).",
sti:"Стили речи: разговорный, научный, официально-деловой, публицистический, художественный. Учитывай стилистическую окраску (нейтральные, книжные/высокие и разговорные/просторечные слова) и речевые штампы.",
kul:"Нормы: орфоэпические (звонИт, тОрты, красИвее), лексические (надеть/одеть, плеоназмы), грамматические (по приезде, согласно приказу, оплатить проезд, пара носков / чулок)."};
const T=[
["orf",0,"В каком слове на месте пропуска пишется одна буква Н?",["стекля_ый","оловя_ый","деревя_ый","кожа_ый"],3,"В отымённых прилагательных с суффиксом -ан- пишется одна Н: кожаный. Слова «стеклянный», «оловянный», «деревянный» — исключения с НН."],
["orf",0,"В каком ряду во всех словах (не) пишется слитно?",["(не)навидеть, (не)годовать, (не)домогать","(не)видеть, (не)смотреть, (не)слышать","(не)читать, (не)писать, (не)отвечать","(не)был, (не)знал, (не)успел"],0,"Глаголы «ненавидеть», «негодовать», «недомогать» без НЕ не употребляются, поэтому пишутся слитно. В остальных рядах глаголы употребляются без НЕ и пишутся раздельно."],
["orf",0,"Вставьте пропущенную букву в слове «зар_сли» (густые заросли у реки).",null,["о"],"В корнях с чередованием -раст-/-ращ-/-рос- без ударения перед С (без Т) пишется О: заросли (но: расти, выращенный)."],
["orf",1,"В каком слове на месте пропуска пишется буква И?",["пр_красный","пр_клеить","пр_одолеть","пр_небрежение"],1,"Приставка ПРИ- в слове «приклеить» имеет значение присоединения. В словах «прекрасный» (= очень), «преодолеть» (= пере-) пишется ПРЕ-, в слове «пренебрежение» приставка срослась с корнем (пишется Е)."],
["orf",0,"В каком слове на конце после шипящего пишется Ь?",["ключ_","плащ_","рож_","мяч_"],2,"Существительные женского рода 3-го склонения на шипящую пишутся с Ь (рожь, ночь, мышь); существительные мужского рода 2-го склонения — без Ь (ключ, плащ, мяч)."],
["orf",0,"В каком слове на месте пропуска пишется разделительный Ъ?",["об_ём","в_юга","кол_цо","руч_ей"],0,"Разделительный Ъ пишется после приставки на согласную перед буквами е, ё, ю, я: объём. В словах «вьюга», «ручей» Ь пишется в корне, в слове «кольцо» Ь обозначает мягкость [л’]."],
["pun",0,"Где нужна запятая в предложении «Прочитав книгу Саша лёг спать»?",["после слова «книгу»","после слова «Саша»","запятая не нужна","после слова «прочитав»"],0,"Деепричастный оборот «прочитав книгу» выделяется запятой независимо от положения в предложении: Прочитав книгу, Саша лёг спать."],
["pun",0,"Выберите предложение без пунктуационной ошибки.",["Мы ждали, что автобус придёт вовремя.","Мы ждали что, автобус придёт вовремя.","Мы ждали что автобус, придёт вовремя.","Мы, ждали что автобус придёт вовремя."],0,"В сложноподчинённом предложении запятая ставится на границе частей перед подчинительным союзом «что»."],
["pun",1,"В каком предложении причастный оборот НЕ выделяется запятыми?",["Дом, стоящий на холме, виден издалека.","Стоящий на холме дом виден издалека.","Лес, окутанный туманом, молчал.","Тропинка, ведущая к реке, заросла травой."],1,"Согласованное определение, выраженное причастным оборотом, стоящее ПЕРЕД определяемым словом («дом») и не имеющее добавочного обстоятельственного значения, не обособляется."],
["pun",0,"Сколько запятых нужно поставить в предложении: «Он сказал что завтра приедет и привезёт подарки»? Ответ запишите цифрой.",null,["1","одна"],"Нужна 1 запятая перед подчинительным союзом «что». Сказуемые «приедет» и «привезёт» однородные и соединены одиночным союзом «и», поэтому запятая между ними не ставится."],
["pun",1,"В каком предложении на месте пропуска ставится тире?",["Рига _ столица Латвии.","Лиса _ хитрая и осторожная.","Мы _ идём домой после уроков.","Он _ быстро бежал по дорожке."],0,"Тире ставится между подлежащим («Рига») и сказуемым («столица»), выраженными существительными в именительном падеже, при нулевой связке."],
["pun",0,"Сколько запятых нужно поставить в предложении «Мама я вернусь поздно»? Ответ запишите цифрой.",null,["1","одна"],"Обращение «мама» стоит в начале предложения и выделяется одной запятой: Мама, я вернусь поздно."],
["mor",0,"Какой частью речи является слово «жарко» в предложении «На улице жарко»?",["наречие","слово категории состояния","краткое прилагательное","глагол"],1,"Слово «жарко» обозначает состояние окружающей среды и выступает главным членом (сказуемым) безличного предложения — это слово категории состояния."],
["mor",1,"Укажите слово, которое является действительным причастием настоящего времени.",["читающий","читая","читаемый","читавший"],0,"«Читающий» — действительное причастие настоящего времени (суффикс -ющ-). «Читая» — деепричастие, «читаемый» — страдательное причастие, «читавший» — причастие прошедшего времени."],
["mor",1,"Какое из приведённых слов является деепричастием?",["лежащий","лёжа","лежал","лежать"],1,"«Лёжа» — деепричастие несовершенного вида (отвечает на вопрос «что делая?», неизменяемо). «Лежащий» — причастие, «лежал» — глагол в форме прошедшего времени, «лежать» — инфинитив."],
["mor",1,"Как пишется (не) в предложении: «(Не)высоко, а низко над водой летели стрижи»?",["слитно","раздельно","через дефис","возможны оба варианта"],1,"При наличии противопоставления с союзом «а» («не высоко, а низко») НЕ с наречиями на -о/-е пишется раздельно."],
["mor",2,"Выберите верное написание в предложении: «Мне (не)кого было спросить о дороге».",["некого","не кого","не-кого","ни кого"],0,"В отрицательных местоимениях без предлога под ударением пишется приставка НЕ- слитно: некого, нечего."],
["sin",0,"Сколько грамматических основ в предложении «Когда пришла весна, птицы вернулись в родные края»? Ответ запишите цифрой.",null,["2","две"],"В этом сложноподчинённом предложении 2 грамматические основы: 1) «пришла весна», 2) «птицы вернулись»."],
["sin",0,"Определите характеристику предложения: «Какое чудесное утро!»",["повествовательное, восклицательное","вопросительное, невосклицательное","побудительное, восклицательное","повествовательное, невосклицательное"],0,"Предложение содержит сообщение о факте действительности (повествовательное) и произносится с сильным чувством (восклицательное)."],
["sin",1,"Какое из предложений является сложносочинённым (ССП)?",["Я знаю, что ты обязательно придёшь.","Пошёл дождь, и мы вернулись домой.","Когда стемнело, в окнах зажгли свет.","Он быстро пришёл и сразу ушёл."],1,"В предложении «Пошёл дождь, и мы вернулись домой» две равноправные грамматические основы («пошёл дождь» и «мы вернулись»), соединённые сочинительным союзом «и». Варианты 1 и 3 — СПП, вариант 4 — простое предложение с однородными сказуемыми."],
["sin",1,"Укажите подлежащее в предложении «В осеннем лесу пахло грибами и прелой листвой».",["лес","грибы","подлежащего нет","листвой"],2,"Это односоставное безличное предложение: действие происходит само по себе, главный член выражен безличным глаголом «пахло», а «грибами» и «листвой» — дополнения в творительном падеже."],
["sin",1,"В каком предложении есть однородные члены?",["Ветер дул, дождь лил.","Всю ночь шёл снег и дождь.","Шёл снег, потом пошёл дождь.","Снег шёл, и дождь шёл."],1,"В предложении «Всю ночь шёл снег и дождь» однородные подлежащие «снег» и «дождь» относятся к общему сказуемому «шёл». В остальных примерах две грамматические основы."],
