V.dash=m=>{const t=tot(),c=cor();m.innerHTML=`<h2>Привет${S.name?', '+esc(S.name):''}!</h2><div class=pn><input id=nm placeholder="Твоё имя" value="${esc(S.name)}"><div class=big id=ck></div><div id=dt></div></div>
<div class=gr><div class=pn><b>${done()}</b><br>заданий из ${T.length}</div><div class=pn><b>${t?Math.round(c/t*100):0}%</b><br>верных ответов</div><div class=pn><b>${lvn()}</b><br>уровень</div><div class=pn><b>${S.streak||0}</b><br>дней подряд</div></div>
<div class=pn><p>Рекомендуем по твоему уровню:</p><button type=button data-go=task data-x=${nx()}>Следующее задание →</button> ${S.last!=null&&T[S.last]?`<button type=button data-go=task data-x=${S.last}>Продолжить с последнего</button>`:''}</div>
<div class=pn><p>Заметки:</p><textarea id=nt placeholder="Правила, которые хочу запомнить…">${esc(S.note)}</textarea></div>`;
$('#nm').oninput=e=>{S.name=e.target.value;save()};$('#nt').oninput=e=>{S.note=e.target.value;save()};clk()};
function clk(){const a=$('#ck');if(a){const d=new Date();a.textContent=d.toLocaleTimeString('ru-RU');$('#dt').textContent=d.toLocaleDateString('ru-RU',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}}
V.task=(m,x)=>{x=+x;if(!T[x])x=0;m.append(card(x));m.insertAdjacentHTML('beforeend',`<button type=button data-go=task data-x=${(x+1)%T.length}>Следующее →</button> <button type=button data-go=olymp>К списку</button>`)};
V.theory=(m,x)=>{x=TP[x]?x:'orf';m.innerHTML=`<h2>THEORY.exe</h2><div class=chips>${Object.keys(TP).map(k=>`<button type=button class="${k==x?'on':''}" data-go=theory data-x=${k}>${TP[k]}</button>`).join('')}</div><div class=pn><h3>${TP[x]}</h3><p>${TH[x]}</p></div><button type=button data-go=olymp data-x=${x}>Задания по теме</button> <button type=button id=chk>Проверь себя</button><div id=ck2></div>`;
$('#chk').onclick=()=>{const ids=T.map((_,i)=>i).filter(i=>T[i][0]==x);$('#ck2').innerHTML='';$('#ck2').append(card(ids[Math.random()*ids.length|0]))}};
function tk(){const t=$('#tv'),r=TM.e-Date.now();if(TM.e&&r<=0){clearInterval(TM.id);TM.e=0;toast('⏰ Время вышло!');if(t)t.textContent='00:00';return}if(t&&TM.e){const s=Math.ceil(r/1e3);t.textContent=String(s/60|0).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}}
V.olymp=(m,x)=>{if(TP[x])OF.k=x;m.innerHTML=`<h2>OLYMPIAD.exe</h2><div class=pn><div class=chips>${['Все',...LV].map((t,j)=>`<button type=button class="${OF.l==j-1?'on':''}" data-j=${j-1}>${t}</button>`).join('')}</div><p><select id=ok>${tops()}</select> <label><input type=checkbox id=of ${OF.f?'checked':''}> только ★</label></p><p>Таймер: <select id=tm><option>10<option selected>20<option>30</select> мин <button type=button id=ts>Старт</button> <b id=tv></b></p></div><div id=ls></div>`;
$('#ok').value=OF.k;$('#ok').onchange=e=>{OF.k=e.target.value;go('olymp')};$('#of').onchange=e=>{OF.f=e.target.checked?1:0;go('olymp')};
m.querySelectorAll('[data-j]').forEach(b=>b.onclick=()=>{OF.l=+b.dataset.j;go('olymp')});
$('#ts').onclick=()=>{clearInterval(TM.id);TM.e=Date.now()+$('#tm').value*6e4;TM.id=setInterval(tk,500);tk()};tk();
const ids=T.map((_,i)=>i).filter(i=>(OF.l<0||T[i][1]==OF.l)&&(!OF.k||T[i][0]==OF.k)&&(!OF.f||S.fl.includes(i)));
$('#ls').innerHTML=`<p>Найдено заданий: ${ids.length}</p>`;ids.forEach(i=>$('#ls').append(card(i)))};
V.test=m=>{if(!TS){m.innerHTML=`<h2>TEST.exe</h2><div class=pn><p>Тема: <select id=tk>${tops()}</select></p><p>Уровень: <select id=tl><option value=-1>Любой<option value=0>BASIC<option value=1>ADVANCED<option value=2>OLYMPIAD</select> Заданий: <select id=tn><option>5<option selected>10<option>15</select></p><button type=button id=tg>Начать тест</button></div>`;
$('#tg').onclick=()=>{const k=$('#tk').value,l=+$('#tl').value,ids=T.map((_,i)=>i).filter(i=>(!k||T[i][0]==k)&&(l<0||T[i][1]==l)).sort(()=>Math.random()-.5);if(!ids.length)return toast('Нет заданий');TS={ids:ids.slice(0,+$('#tn').value),i:0,r:[]};go('test')};return}
if(TS.i>=TS.ids.length){const ok=TS.r.filter(x=>x.ok).length,bad=TS.r.filter(x=>!x.ok);m.innerHTML=`<h2>Результат</h2><div class=pn><b class=big>${ok}/${TS.ids.length}</b> (${Math.round(ok/TS.ids.length*100)}%)</div>${bad.length?'<h3>Разбор ошибок</h3>'+bad.map(x=>{const t=T[x.i];return`<div class=pn><p>${esc(t[2])}</p><p>Ответ: <b>${esc(t[3]?t[3][t[4]]:t[4][0])}</b></p><p>${esc(t[5])}</p></div>`}).join(''):'<p>Без ошибок! 🎉</p>'}<button type=button id=rt>Пройти ещё раз</button> <button type=button id=nt2>Новый тест</button>`;
$('#rt').onclick=()=>{TS.i=0;TS.r=[];go('test')};$('#nt2').onclick=()=>{TS=null;go('test')};return}
m.innerHTML=`<h2>TEST.exe</h2><p>Вопрос ${TS.i+1} из ${TS.ids.length}</p>`;const id=TS.ids[TS.i];
m.append(card(id,(ok,d)=>{TS.r.push({i:id,ok});const b=document.createElement('button');b.type='button';b.textContent=TS.i+1<TS.ids.length?'Дальше →':'Результаты';b.onclick=()=>{TS.i++;go('test')};d.append(b)}))};
V.arch=(m,x)=>{x=AR[x]?x:Object.keys(AR)[0];m.innerHTML=`<h2>ARCHIVE</h2><div class=chips>${Object.keys(AR).map(k=>`<button type=button class="${k==x?'on':''}" data-go=arch data-x="${k}">${k}</button>`).join('')}</div><div class=pn>${AR[x].map(t=>`<p>• ${t}</p>`).join('')}</div>`};
V.daily=m=>{const t=today(),i=(Math.floor(Date.now()/864e5)*7)%T.length;m.innerHTML=`<h2>DAILY QUEST</h2><p>Задание на ${t}. ${S.dq[t]?'✔ Уже выполнено сегодня.':'Ещё не выполнено.'} Серия: ${S.streak} дн.</p>`;m.append(card(i,ok=>{S.dq[t]=ok?2:1;save()}))};
V.prog=m=>{const c=cor(),t=tot(),wk=Object.keys(TP).filter(weak),rows=Object.keys(TP).map(k=>{const s=tps(k),all=T.filter(x=>x[0]==k).length,dn=T.filter((x,i)=>x[0]==k&&S.st[i]).length;return`<div>${TP[k]}: ${dn}/${all}, точность ${s.a?s.p+'%':'—'} ${weak(k)?'⚠':''}<div class=bar><i style="width:${s.p}%"></i></div></div>`}).join('');
m.innerHTML=`<h2>PROGRESS</h2><div class=gr><div class=pn><b>${Math.round(done()/T.length*100)}%</b><br>выполнено (${done()}/${T.length})</div><div class=pn><b>${c}</b><br>верных</div><div class=pn><b>${t-c}</b><br>неверных</div><div class=pn><b>${S.streak}</b><br>серия дней</div></div>
<div class=pn><h3>По темам</h3>${rows}</div><div class=pn><h3>Слабые темы</h3>${wk.length?wk.map(k=>`<button type=button data-go=theory data-x=${k}>${TP[k]}</button>`).join(' '):'Пока нет — так держать!'}</div>
<div class=pn><h3>Сложные задания ★</h3>${S.fl.filter(i=>T[i]).length?S.fl.filter(i=>T[i]).map(i=>`<p class=link data-go=task data-x=${i}>${esc(T[i][2])}</p>`).join(''):'Отмечай задания звёздочкой ☆, чтобы вернуться к ним.'}</div>
<div class=pn><h3>Достижения</h3>${AC.map(a=>`<div class="${S.ac.includes(a[0])?'':'lk'}">🏆 <b>${a[0]}</b> — ${a[1]}</div>`).join('')}</div>
<div class=pn><h3>История занятий</h3>${S.h.filter(x=>T[x.i]).slice(0,15).map(x=>`<div>${x.d} · ${x.ok?'✓':'✗'} · ${esc(T[x.i][2].slice(0,45))}…</div>`).join('')||'Пока пусто'}</div><button type=button id=rst>Сбросить прогресс</button>`;
$('#rst').onclick=function(){if(this.dataset.s){S={...S,st:{},h:[],streak:0,ld:'',fl:[],last:null,dq:{},ac:[]};save();go('prog')}else{this.dataset.s=1;this.textContent='Точно сбросить? Нажми ещё раз'}}};
V.find=(m,x)=>{const q=n(x),th=Object.keys(TP).filter(k=>n(TP[k]+' '+TH[k]).includes(q)),ts=T.map((_,i)=>i).filter(i=>n(T[i][2]+' '+T[i][5]).includes(q));
m.innerHTML=`<h2>Поиск: ${esc(x)}</h2><h3>Теория (${th.length})</h3>${th.map(k=>`<div class="pn link" data-go=theory data-x=${k}>${TP[k]}</div>`).join('')}<h3>Задания (${ts.length})</h3>${ts.map(i=>`<div class="pn link" data-go=task data-x=${i}>${esc(T[i][2])}</div>`).join('')}`};
function setTheme(t){const valid=TS_.some(a=>a[0]===t)?t:'alt';document.documentElement.setAttribute('data-th',valid);document.body.setAttribute('data-th',valid);S.th=valid;document.querySelectorAll('#thm [data-th]').forEach(b=>b.classList.toggle('on',b.dataset.th===valid));save()}
function toggleThemeMenu(force){const m=$('#thm'),b=$('#thb');const open=typeof force==='boolean'?force:m.hidden;m.hidden=!open;b.setAttribute('aria-expanded',String(open))}
$('#nv').innerHTML=NAV.map(a=>`<button type=button data-go=${a[0]}>${a[1]}</button>`).join('');
$('#thm').innerHTML=TS_.map(a=>`<button type=button role=menuitem data-th=${a[0]}><span class=pv style="background:${a[2][0]}"><i style="background:${a[2][1]}"></i><i style="background:${a[2][2]}"></i></span><span>${a[1]}</span></button>`).join('');
$('#thb').addEventListener('click',e=>{e.stopPropagation();toggleThemeMenu()});
$('#thm').addEventListener('click',e=>{e.stopPropagation();const t=e.target.closest('[data-th]');if(t){setTheme(t.dataset.th);toggleThemeMenu(false)}});
document.addEventListener('click',e=>{if(!e.target.closest('.thw'))toggleThemeMenu(false);const b=e.target.closest('[data-go]');if(b&&!b.disabled)go(b.dataset.go,b.dataset.x)});
document.addEventListener('keydown',e=>{if(e.key==='Escape')toggleThemeMenu(false)});
$('#sq').oninput=e=>{const v=e.target.value.trim();v.length>1?go('find',v):go('dash')};
setInterval(clk,1000);setTheme(TS_.some(a=>a[0]===S.th)?S.th:'alt');go('dash');
</script></body></html>
